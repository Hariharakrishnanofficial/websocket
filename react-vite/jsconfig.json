{
  "compilerOptions": {
    "baseUrl": "src",
    "paths": {
      "@app/*":      ["app/*"],
      "@features/*": ["features/*"],
      "@shared/*":   ["shared/*"],
      "@services/*": ["services/*"],
      "@stores/*":   ["stores/*"],
      "@config/*":   ["config/*"],
      "@assets/*":   ["assets/*"]
    },
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2020",
    "checkJs": false
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
