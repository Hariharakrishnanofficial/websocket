{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "UI / PWA Settings",
  "description": "Frontend presentation, PWA manifest, and user experience settings.",
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "pattern": "^ui\\.(development|staging|production)$"
    },
    "environment": {
      "type": "string",
      "enum": ["development", "staging", "production"]
    },
    "pwa": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "appName": { "type": "string", "maxLength": 100 },
        "shortName": { "type": "string", "maxLength": 30 },
        "description": { "type": "string", "maxLength": 500 },
        "themeColor": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "backgroundColor": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "display": {
          "type": "string",
          "enum": ["standalone", "fullscreen", "minimal-ui", "browser"],
          "default": "standalone"
        },
        "orientation": {
          "type": "string",
          "enum": ["portrait", "landscape", "any"],
          "default": "portrait"
        },
        "startUrl": { "type": "string", "default": "/" },
        "scope": { "type": "string", "default": "/" },
        "iconSizes": {
          "type": "array",
          "items": { "type": "integer", "minimum": 16 },
          "default": [72, 96, 128, 144, 152, 192, 384, 512]
        }
      },
      "required": ["enabled", "appName", "shortName"]
    },
    "layout": {
      "type": "object",
      "properties": {
        "controlPadPosition": {
          "type": "string",
          "enum": ["bottom", "center", "right"],
          "default": "bottom"
        },
        "controlPadSize": {
          "type": "string",
          "enum": ["small", "medium", "large"],
          "default": "large"
        },
        "showHeader": { "type": "boolean", "default": true },
        "showFooter": { "type": "boolean", "default": false },
        "compactMode": { "type": "boolean", "default": false },
        "statusBarPosition": {
          "type": "string",
          "enum": ["top", "bottom", "hidden"],
          "default": "top"
        }
      }
    },
    "branding": {
      "type": "object",
      "properties": {
        "logoUrl": { "type": "string" },
        "faviconUrl": { "type": "string" },
        "primaryColor": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "secondaryColor": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "accentColor": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "fontFamily": { "type": "string" }
      }
    },
    "accessibility": {
      "type": "object",
      "properties": {
        "highContrastMode": { "type": "boolean", "default": false },
        "reducedMotion": { "type": "boolean", "default": false },
        "hapticFeedback": { "type": "boolean", "default": true },
        "audioFeedback": { "type": "boolean", "default": false },
        "largeButtons": { "type": "boolean", "default": false },
        "screenReaderHints": { "type": "boolean", "default": true }
      }
    },
    "configVersion": { "type": "integer", "minimum": 1 },
    "active": { "type": "boolean" },
    "createdAt": { "type": "string", "format": "date-time" },
    "createdBy": { "type": "string" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "updatedBy": { "type": "string" },
    "changeReason": { "type": "string", "maxLength": 500 }
  },
  "required": [
    "key", "environment", "pwa",
    "configVersion", "active",
    "createdAt", "createdBy", "updatedAt", "updatedBy", "changeReason"
  ],
  "additionalProperties": false
}
