{
  "name": "websocket-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Realtime ESP32 robot controller — PWA front-end, Node.js WS relay (AppSail), and shared protocol package.",
  "workspaces": [
    "react-vite",
    "appsail-nodejs",
    "packages/*"
  ],
  "scripts": {
    "dev:web":    "npm --workspace react-vite run dev",
    "dev:relay":  "npm --workspace appsail-nodejs run dev",
    "build":      "npm --workspace react-vite run build",
    "build:web":  "npm --workspace react-vite run build",
    "test:relay": "npm --workspace appsail-nodejs test",
    "test":       "npm --workspace appsail-nodejs test",
    "lint":       "npm --workspace react-vite run lint"
  },
  "engines": {
    "node": ">=18"
  }
}
